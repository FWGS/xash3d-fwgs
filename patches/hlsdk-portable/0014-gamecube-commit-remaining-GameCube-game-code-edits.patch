Subject: [PATCH 14/14] gamecube: commit remaining GameCube game-code edits

Commit the uncommitted client/monsters/sound/world/pm_shared edits from
the Expansion drive working tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/client.cpp       | 10 ++++-----
 dlls/enginecallback.h | 11 +++++++---
 dlls/monsters.cpp     | 32 ++++++++++++++++++++++++++++-
 dlls/sound.cpp        | 12 +++++------
 dlls/world.cpp        | 48 +++++++++++++++++++++++++------------------
 pm_shared/pm_shared.c | 10 +++++++--
 6 files changed, 85 insertions(+), 38 deletions(-)

diff --git a/dlls/client.cpp b/dlls/client.cpp
index b7e85287..c3bb5389 100644
--- a/dlls/client.cpp
+++ b/dlls/client.cpp
@@ -216,12 +216,10 @@ void ClientPutInServer( edict_t *pEntity )
 	if( g_engfuncs.CheckParm( (char *)"-gcnewgame", NULL )
 		|| g_engfuncs.CheckParm( (char *)"-gcmenuplaystart", NULL ))
 	{
-		/* The normal PlayerSpawn gamerules dispatch is unsafe on the static
-		 * GameCube ABI. Crowbar GiveNamedItem softlocks after G326 pre-map
-		 * client keep (20260810-002542: hang before SV_SetModel w_crowbar).
-		 * Inventory is planted later via G103/G120 landmark path.
-		 * Menu New Game (-gcmenuplaystart) hits the same softlock. */
-		ALERT( at_console, "*GameCube: ClientPutInServer stage=crowbar skipped (G326)\n" );
+		/* The early PlayerSpawn gamerules dispatch is unsafe on the static
+		 * GameCube ABI. The engine re-arms the retail crowbar immediately
+		 * after this callback through its safe post-spawn create/touch path. */
+		ALERT( at_console, "*GameCube: ClientPutInServer stage=crowbar deferred (G326)\n" );
 	}
 	#endif
 
diff --git a/dlls/enginecallback.h b/dlls/enginecallback.h
index dd38cb4d..a11e398a 100644
--- a/dlls/enginecallback.h
+++ b/dlls/enginecallback.h
@@ -166,9 +166,14 @@ inline void *GET_PRIVATE( edict_t *pent )
 // keep the lean static actors.
 inline BOOL GC_FullActors( void )
 {
-	return g_engfuncs.CheckParm( (char *)"-gcmenuplaystart", NULL )
-		&& !g_engfuncs.CheckParm( (char *)"-gcmenunoserver", NULL )
-		&& !g_engfuncs.CheckParm( (char *)"-gcfullphysics", NULL );
+	if( g_engfuncs.CheckParm( (char *)"-gcmenunoserver", NULL ))
+		return FALSE;
+
+	/* An explicit full-actors request is authoritative even when paired with
+	 * full physics. The old final -gcfullphysics veto silently disabled retail
+	 * AI sound, sentence groups, and node graphs in the normal play profile. */
+	return g_engfuncs.CheckParm( (char *)"-gcfullactors", NULL )
+		|| g_engfuncs.CheckParm( (char *)"-gcmenuplaystart", NULL );
 }
 #endif
 
