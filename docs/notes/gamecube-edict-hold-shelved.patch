diff --git a/engine/platform/gamecube/mem_gamecube.c b/engine/platform/gamecube/mem_gamecube.c
index bb82207c5e..715f68da1c 100644
--- a/engine/platform/gamecube/mem_gamecube.c
+++ b/engine/platform/gamecube/mem_gamecube.c
@@ -860,6 +860,40 @@ void GC_DiscardMapLoadBuffer( void )
 qboolean Mod_GCEnsureStaticReserves( void );
 qboolean SV_GCEnsureStringArena( void );
 
+/*
+ * Retail New Game needs one contiguous edict table (900 edicts, ~706 KiB)
+ * in SV_LoadProgs.  At the menu the heap top still has ~1 MiB unclaimed in
+ * one piece, but the play-start trims and map-load allocations leave the same
+ * amount free only in fragments ("out of memory 706.64 Kb at sv_game.c").
+ * Hold the hole: take the block when play start begins, and free it just
+ * before the edict allocation, which then gets the same coalesced span.
+ */
+static void *gc_edict_hold;
+static size_t gc_edict_hold_bytes;
+
+void GC_HoldEdictTable( size_t bytes )
+{
+	if( gc_edict_hold || bytes == 0 )
+		return;
+	/* slack for the zone block header and pool bookkeeping */
+	bytes += 4096;
+	GC_MemHeapMark( "edict_hold" );
+	gc_edict_hold = malloc( bytes );
+	gc_edict_hold_bytes = gc_edict_hold ? bytes : 0;
+	Con_Reportf( "Xash3D GameCube: edict table hold %s %s\n", Q_memprint( bytes ),
+		gc_edict_hold ? "taken" : "unavailable" );
+}
+
+void GC_ReleaseEdictHold( void )
+{
+	if( !gc_edict_hold )
+		return;
+	free( gc_edict_hold );
+	gc_edict_hold = NULL;
+	Con_Reportf( "Xash3D GameCube: edict table hold released %s\n", Q_memprint( gc_edict_hold_bytes ));
+	gc_edict_hold_bytes = 0;
+}
+
 void GC_BeginMapLoadMemoryOpt( void )
