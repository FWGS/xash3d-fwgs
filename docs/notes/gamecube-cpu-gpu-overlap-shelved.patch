+/*
+ * CPU/GPU overlap (-gcoverlap, gamecube.cfg "overlap"; off by default).
+ *
+ * The retail present was serial: DrawDone (the CPU waits for Flipper to
+ * finish frame N), CopyDisp, then VIDEO_WaitVSync, so game logic for frame
+ * N+1 only started after Flipper was done with frame N.  With overlap the
+ * present queues frame N's CopyDisp plus a draw-sync token and returns at
+ * once.  The next present (or any synchronous present path, via
+ * GC_OverlapDrain) waits for that token, which Flipper normally passed long
+ * before, shows that XFB on the next vsync, and only then copies into the
+ * other XFB, so a buffer on screen is never overwritten.  Cost: one frame
+ * more latency.  CPU writes to memory Flipper may still sample (hot texture
+ * ring, light style atlas) call GC_GXOverlapWaitGpu first.
+ */
+static int gc_overlap = -1;
+static int gc_ov_pending_fb = -1;
+static u16 gc_ov_pending_token;
+static unsigned int gc_ov_trace = 4; /* breadcrumbs for the first frames */
+static qboolean GC_GXFenceReached( u16 token );
+qboolean GC_GXFenceWait( u16 token );
+
+qboolean GC_OverlapEnabled( void )
+{
+	if( gc_overlap < 0 )
+		gc_overlap = Sys_CheckParm( "-gcoverlap" ) ? 1 : 0;
+	return gc_overlap > 0;
+}
+
+/* Show the queued overlap frame: wait for its copy, swap on the vsync. */
+static void GC_OverlapDrain( void )
+{
+	if( gc_ov_pending_fb < 0 )
+		return;
+	if( !GC_GXFenceReached( gc_ov_pending_token ))
+		GC_GXFenceWait( gc_ov_pending_token );
+	VIDEO_SetNextFramebuffer( xfb[gc_ov_pending_fb] );
+	VIDEO_Flush();
+	VIDEO_WaitVSync();
+	gc_ov_pending_fb = -1;
+}
+
 static qboolean GC_GXDrawDoneTimed( const char *where )
 {
 	u16 token;
@@ -157,6 +199,7 @@ static qboolean GC_GXDrawDoneTimed( const char *where )
 	u8 overhi = 0, underlo = 0, read_idle = 0, cmd_idle = 0, brkpt = 0;
 
 	GC_WatchdogMark( where );
