+ * light style atlas), wait until the previous overlapped frame is drawn. */
+void GC_GXOverlapWaitGpu( void )
+{
+	if( gc_ov_pending_fb >= 0 && !GC_GXFenceReached( gc_ov_pending_token ))
+		GC_GXFenceWait( gc_ov_pending_token );
+}
