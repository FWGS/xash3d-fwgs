def options(opt):
	pass

def configure(conf):
	pass

def build(bld):
	# linked into every image by scripts/waifulib/ps4.py
	bld.objects(source = 'ps4_cwd.c', target = 'ps4compat_cwd')
	bld.objects(source = 'ps4_stdio.c', target = 'ps4compat_stdio')
	bld.objects(source = 'ps4_crtlib.c', target = 'ps4compat_crtlib')
	bld.objects(source = 'ps4_malloc.c', target = 'ps4compat_malloc')
	bld.objects(source = 'ps4_malloc.c', target = 'ps4compat_malloc_module', defines = ['PS4_MODULE=1'])
