#! /usr/bin/env python
# encoding: utf-8

def options(opt):
	pass

def configure(conf):
	if not conf.path.find_node('opengnm/src/drawcommandbuffer.c'):
		conf.fatal('Can\'t find opengnm submodule. Run `git submodule update --init --checkout 3rdparty/opengnm/opengnm`.')

def build(bld):
	bld.stlib(
		source = bld.path.ant_glob('opengnm/src/**/*.c', excl = 'opengnm/src/*_generic.c'),
		target = 'opengnm',
		features = 'c',
		includes = ['opengnm/include', 'opengnm/src'],
		export_includes = 'opengnm/include',
		defines = ['OPENGNM_ORBIS'],
		cflags = ['-std=gnu11', '-Wno-unused-parameter'],
		use = 'PS4GNM_SYS',
		install_path = None,
	)
